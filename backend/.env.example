APP_NAME=The Lenny Growth Assistant
APP_VERSION=1.0.0
DEBUG=True

# PostgreSQL database connection string
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/lenny_assistant

# Default LLM Provider: "claude" (OpenRouter) or "ollama" (local)
LLM_PROVIDER=ollama

# Ollama local configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenRouter API Key — get yours at https://openrouter.ai/keys
# This key is used when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=sk-or-your-openrouter-key-here

# OpenRouter Model slug — e.g. anthropic/claude-opus-4-5
# Full list: https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-opus-4-5

# Embedding model for ChromaDB vector store
EMBEDDING_MODEL=all-MiniLM-L6-v2